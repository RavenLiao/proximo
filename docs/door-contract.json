{
  "contract": 1,
  "about": "Proximo's MCP door as any client meets it: the six tools and the shapes their answers take. Generated by scripts/gen_door_contract.py; a change raises `contract` and the CHANGELOG says so. A release that leaves the number alone leaves the door alone.",
  "tools": [
    {
      "name": "proximo_find",
      "description": "READ-ONLY: search every API address the planes publish, in plain words ('list datastores', 'guest status'). A verb picks the method; other words match the path, the vendor's description, parameter names. 5 by default. Returns access and the authored blast-radius tier.",
      "inputSchema": {
        "properties": {
          "query": {
            "title": "Query",
            "type": "string"
          },
          "plane": {
            "anyOf": [
              {
                "enum": [
                  "pve",
                  "pbs",
                  "pmg",
                  "pdm"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Plane"
          },
          "limit": {
            "default": 5,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "title": "findArguments",
        "type": "object"
      },
      "readOnlyHint": true
    },
    {
      "name": "proximo_plan",
      "description": "READ-ONLY: the governed verdict for one address and the vendor's published parameters. Mutates nothing. A mutation's plan also reads the target (one governed read, receipted): current, change (from/to per argument), noop. Run before proximo_call. path may be words: one match is planned, several come back to pick from.",
      "inputSchema": {
        "properties": {
          "plane": {
            "enum": [
              "pve",
              "pbs",
              "pmg",
              "pdm"
            ],
