            "title": "Args"
          }
        },
        "required": [
          "plane",
          "method",
          "path"
        ],
        "title": "_planArguments",
        "type": "object"
      },
      "readOnlyHint": true
    },
    {
      "name": "proximo_read",
      "description": "READ-ONLY: run any GET the plane publishes, by path. Rows come back LEAN with a total (names, states, ids) unless fields='all' or fields='name,status'. Over the cap: counts per state and the odd rows; fields= gets rows. since='24h' (30m, 7d): what changed, from the door's own snapshots, no vendor call. Credentials come back withheld. wait=N on a .../tasks/{upid}/status address waits up to N s (max 600) for the task's end. diagnose=true on a node or guest path: its health reads and advisory flags, one call.",
